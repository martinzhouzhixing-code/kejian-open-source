# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
KEJIAN_APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
KEJIAN_DB_PATH=/data/kejian.db
KEJIAN_AUDIO_QUEUE_DIR=/data/audio
KEJIAN_PUBLIC_ORIGIN=https://ai.example.com
# A vision-capable model with chat-completions + structured tool output.
# Set these to the provider/model your own API Key can access.
KEJIAN_AI_PROVIDER=compatible
KEJIAN_AI_URL=https://YOUR_PROVIDER/v1/chat/completions
KEJIAN_AI_MODEL=YOUR_VISION_MODEL
KEJIAN_AUDIO_SUMMARY_URL=https://YOUR_PROVIDER/v1/chat/completions
KEJIAN_AUDIO_SUMMARY_MODEL=YOUR_TEXT_MODEL
KEJIAN_AUDIO_RESOURCE_ID=volc.seedasr.auc
