<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp">
<ImageView android:id="@android:id/background" android:clipToOutline="true" android:src="@drawable/widget_preview_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:id="@+id/widget_color_tag" android:src="@drawable/widget_preview_tag" android:layout_width="5dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="课程颜色" />
<TextView android:id="@+id/widget_label" android:text="今天" android:textColor="@color/widget_preview_ink" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
</LinearLayout>
<TextView android:id="@+id/widget_time" android:text="09:00" android:textColor="@color/widget_preview_ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp" android:fontFamily="sans-serif-condensed-medium" />
<TextView android:id="@+id/widget_title" android:text="线性代数" android:textColor="@color/widget_preview_ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp" android:fontFamily="sans-serif-medium" />
<TextView android:id="@+id/widget_place" android:text="A201" android:textColor="@color/widget_preview_ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp" />
<TextView android:id="@+id/widget_hint" android:text="10:30 结束" android:textColor="@color/widget_preview_ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp" />
<TextView android:visibility="gone" android:id="@+id/widget_agenda" android:text="● 14:00 · 大学英语" android:textColor="@color/widget_preview_ink" android:layout_width="match_parent" android:layout_height="0dp" android:textSize="11sp" android:maxLines="15" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="8dp" android:layout_weight="1" />
</LinearLayout></FrameLayout>
