<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp">
<ImageView android:id="@android:id/background" android:clipToOutline="true" android:src="@drawable/widget_preview_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
<LinearLayout android:id="@+id/widget_empty_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="14dp">
    <TextView android:textColor="@color/widget_preview_ink" android:id="@+id/widget_empty_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="课间 · 今日名句" android:textSize="9sp" android:letterSpacing="0.08" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" />
    <TextView android:textColor="@color/widget_preview_ink" android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="千里之行，始于足下。" android:textSize="15sp" android:lineSpacingExtra="3dp" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" />
    <TextView android:textColor="@color/widget_preview_ink" android:id="@+id/widget_empty_divider" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textSize="10sp" android:includeFontPadding="false" />
    <TextView android:textColor="@color/widget_preview_ink" android:id="@+id/widget_empty_quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="《道德经》" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="2dp" android:includeFontPadding="false" />
</LinearLayout>
</FrameLayout>
